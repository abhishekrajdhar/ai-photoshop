# ─────────────────────────────────────────────────────────────────────────────
# CutPilot AI — environment configuration
# Copy to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                # development | production | test
APP_URL=http://localhost:3000      # public URL of the web app (used for links, CORS)
API_URL=http://localhost:8000      # public URL of the API (used by the web app server-side)
LOG_LEVEL=INFO

# ── Database / cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://cutpilot:cutpilot@postgres:5432/cutpilot
REDIS_URL=redis://redis:6379/0
DB_SCHEMA=                         # optional: isolate tables in a PostgreSQL schema (e.g. cutpilot) when sharing a database

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                # set true behind HTTPS in production
COOKIE_SAMESITE=lax                # "none" when the web app and API are on different sites (forces Secure)
COOKIE_DOMAIN=                     # e.g. .example.com to share cookies between app. and api. subdomains
CORS_ORIGINS=                      # extra allowed origins, comma-separated (e.g. Vercel preview URLs)

# ── AI providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=openai                 # openai | anthropic
AI_FALLBACK_PROVIDER=anthropic     # openai | anthropic | (empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_PLANNER_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ANTHROPIC_PLANNER_MODEL=claude-opus-5     # or claude-sonnet-5 for lower cost
ANTHROPIC_VISION_MODEL=claude-opus-5
ANTHROPIC_EFFORT=                        # optional: low | medium | high | xhigh | max (default high)
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=120

# ── Local / open-source AI adapters (optional) ───────────────────────────────
LOCAL_TRANSCRIPTION_ENABLED=false  # true → force TRANSCRIPTION_PROVIDER below. Without OPENAI_API_KEY the API
                                   # automatically uses faster-whisper (bundled in the Docker image, CPU).
TRANSCRIPTION_PROVIDER=openai      # openai | whisperx | faster_whisper
WHISPER_MODEL_SIZE=base            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                 # cpu | cuda
LOCAL_DIARIZATION_ENABLED=false    # requires pyannote.audio + HF token
HF_TOKEN=
LOCAL_VISION_ENABLED=false         # reserved: local CLIP/SigLIP adapters

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local             # local | s3
LOCAL_STORAGE_ROOT=/data/storage   # inside containers (mounted volume)
S3_ENDPOINT=http://minio:9000      # leave empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET=cutpilot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SIGNED_URL_TTL_SECONDS=3600
S3_FORCE_PATH_STYLE=true

# ── Media processing ─────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_SIZE=10737418240        # bytes (10 GiB)
UPLOAD_CHUNK_SIZE=8388608          # bytes (8 MiB) — chunked/resumable uploads
PROXY_HEIGHT=720
PROXY_VIDEO_BITRATE=2500k
WORK_DIR=/data/work                # scratch space for workers

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20

# ── Web app (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=CutPilot AI
NEXT_PUBLIC_API_BASE=/api          # "/api" = proxied through Next.js; or an absolute URL (https://api.example.com/api) for direct calls
INTERNAL_API_URL=http://api:8000   # server-side URL of the API inside docker

# ── Rendering ────────────────────────────────────────────────────────────────
CAPTION_FONT_PATH=                 # optional TTF/OTF for burned-in captions (defaults: Inter → DejaVu → Arial)
WORKER_CONCURRENCY=2               # celery worker processes per container
